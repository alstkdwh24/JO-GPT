# =====================================================
# Frontend (React - nginx로 서빙)
# 빌드 컨텍스트: 프로젝트 루트
# docker build -f Dockerfile.frontend -t jo-gpt-front .
# =====================================================

# 1단계: 빌드
FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/web-jogpt-ui/package*.json ./
RUN npm ci
COPY frontend/web-jogpt-ui/ .
RUN npm run build

# 2단계: nginx로 정적 파일 서빙
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80